[Unit]
Description=Magi automatic blind star calibration
Wants=network-online.target
After=network-online.target
RequiresMountsFor=@ROOT@

[Service]
Type=oneshot
User=magi
Group=magi
WorkingDirectory=/opt/magi
Environment=PYTHONPATH=/opt/magi/src
ExecStart=/usr/bin/python3 -m magi.star_worker @CONFIG@ --latest primary
UMask=0077
TimeoutStartSec=900
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@ROOT@ @RUNTIME@
MemoryMax=768M
CPUQuota=25%
Nice=10
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
