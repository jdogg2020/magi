[Unit]
Description=Magi continuous sky-camera recorder
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/mnt/magi-ssd
StartLimitIntervalSec=0

[Service]
Type=simple
User=magi
Group=magi
WorkingDirectory=/opt/magi
Environment=PYTHONPATH=/opt/magi/src
ExecStart=/usr/bin/python3 -m magi run --config /etc/magi/config.json
RuntimeDirectory=magi
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/magi-ssd/magi /run/magi /etc/magi
ReadOnlyPaths=/mnt/magi-ssd/.magi-volume
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
